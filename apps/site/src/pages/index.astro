---
// Caddie landing — 2026-10-25 redo for first-time, non-technical builders.
// Keeps the brand, theme logic, self-hosted fonts and static no-JS page.
// Every product image is a real app screenshot (Shot slots, public/shots/);
// a slot without a capture shows an obvious "Screenshot coming" frame.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/site.css';
import Hero from '../components/Hero.astro';
import Shot from '../components/Shot.astro';
import { hasShot } from '../lib/shots';
const appHref = import.meta.env.DEV ? 'http://localhost:5176/app/' : '/app/';
const inviteHref = 'mailto:captjay98@gmail.com?subject=Caddie%20invite%20request';
const showExample = hasShot('example', 'phone') || hasShot('example', 'desktop');

const steps = [
	{
		n: '01',
		title: 'Tell Caddie your idea',
		body: 'Type it the way you would explain it to a friend. Caddie asks a few questions, then writes a plan in plain words.',
		shot: 'step-idea',
		alt: 'Chatting with Caddie about an app idea',
	},
	{
		n: '02',
		title: 'Approve the plan and the look',
		body: 'You see the screens before anything is built. Change what you do not like. Nothing is built until you say yes.',
		shot: 'step-design',
		alt: 'Reviewing the screens Caddie designed before building',
	},
	{
		n: '03',
		title: 'Caddie builds it, one feature at a time',
		body: 'Each feature is written, then tested. If a test fails, Caddie fixes it. You are never asked to read or repair code.',
		shot: 'step-build',
		alt: 'Build progress, feature by feature, with test results',
	},
	{
		n: '04',
		title: 'Try it and share it',
		body: 'Open a live preview on your phone or laptop. Publish it with sign-in, a database and AI already set up, or get an Android app.',
		shot: 'step-share',
		alt: 'The finished app open on a phone',
	},
];

const promises = [
	{ title: 'You never have to fix code', body: 'Caddie runs the app’s own tests and repairs what fails. That is its job, not yours.' },
	{ title: 'It only says “ready” when it is', body: '“Ready to try” appears only when there is a working preview you can open.' },
	{ title: 'If it gets stuck, it tells you plainly', body: 'What is saved, what is not done yet, and what happens next. Your work is never thrown away.' },
	{ title: 'Nothing happens without your OK', body: 'The plan, the design and publishing all wait for you to approve them.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Caddie builds apps from your idea — no coding needed. Tell it what you want to make; it plans with you, builds and tests it, and gives you a link to share. Start with a hackathon."
		/>
		<meta name="theme-color" content="#090b10" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Caddie — you have an idea, it builds the app</title>
		<script is:inline>
			// Theme pre-paint (v2 §3.9): the site and app share one origin and one
			// `caddie-theme` key. No saved choice → follow the device. This runs
			// before first paint; the page is fully readable with JS disabled.
			try {
				var saved = localStorage.getItem('caddie-theme');
				var theme = saved === 'light' || saved === 'dark' ? saved : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
				document.documentElement.setAttribute('data-theme', theme);
			} catch (e) {
				document.documentElement.setAttribute('data-theme', 'dark');
			}
		</script>
	</head>
	<body>
		<div class="pb">
			<a class="skip" href="#pb-main">Skip to content</a>

			<div class="topbar">
				<span class="wordmark">
					<svg class="wordmark-mascot" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
						<defs><linearGradient id="pb-mascot" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4d9fff"/><stop offset="1" stop-color="#2f7ddd"/></linearGradient></defs>
						<g><path d="M43 18V4.5" stroke="#2f7ddd" stroke-width="2.6" stroke-linecap="round" fill="none"/><path d="M43.6 4.6 53 8.1l-9.4 3.5z" fill="#f0a83c" stroke="#f0a83c" stroke-width="1.4" stroke-linejoin="round"/></g>
						<rect x="9" y="16.5" width="46" height="41.5" rx="18" fill="url(#pb-mascot)"/>
						<g fill="#090b10"><rect x="21" y="30" width="6.5" height="11" rx="3.25"/><rect x="36.5" y="30" width="6.5" height="11" rx="3.25"/><circle cx="25.4" cy="32.7" r="1.3" fill="#fff"/><circle cx="40.9" cy="32.7" r="1.3" fill="#fff"/></g>
						<path d="M28.6 46.6q3.4 3 6.8 0" fill="none" stroke="#090b10" stroke-width="2.2" stroke-linecap="round"/>
					</svg>
					<span>Caddie</span>
				</span>
				<nav aria-label="Page sections">
					<a href="#how">How it works</a>
					<a href="#hackathons">Hackathons</a>
					<a href="#tech">Under the hood</a>
					<a href="#judges">For judges</a>
				</nav>
				<div class="actions">
					<button type="button" class="theme-toggle" data-pb-theme hidden aria-label="Switch to light theme">◐</button>
					<a class="btn btn-line" href={appHref}>Sign in</a>
				</div>
			</div>

			<main id="pb-main">
				<Hero />

				{/* HOW IT WORKS ───────────────────────────────────────── */}
				<section class="band" id="how" aria-labelledby="how-h">
					<div class="band-head">
						<div>
							<p class="lbl mono" style="margin-bottom: 1rem;">How it works</p>
							<h2 id="how-h" class="h2">From an idea to an app you can share, in four steps.</h2>
						</div>
						<p class="lede">
							You make the decisions. Caddie does the building, the testing and
							the fixing.
						</p>
					</div>
					<ol class="steps">
						{steps.map((step) => (
							<li class="step" data-step={step.n}>
								<div class="step-text">
									<p class="step-n mono">Step {step.n}</p>
									<h3>{step.title}</h3>
									<p class="lede">{step.body}</p>
								</div>
								<Shot name={step.shot} device={step.shot === 'step-share' ? 'phone' : 'desktop'} alt={step.alt} />
							</li>
						))}
					</ol>
				</section>

				{/* PROMISES ───────────────────────────────────────────── */}
				<section class="band" id="promise" aria-labelledby="promise-h">
					<div class="band-head">
						<div>
							<p class="lbl mono" style="margin-bottom: 1rem;">No code, no guesswork</p>
							<h2 id="promise-h" class="h2">Built for people who have never written code.</h2>
						</div>
						<p class="lede">
							Most AI app builders leave you alone when something breaks. Caddie
							is built to carry that part.
						</p>
					</div>
					<ul class="promises">
						{promises.map((p) => (
							<li>
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</li>
						))}
					</ul>
				</section>

				{/* HACKATHONS ─────────────────────────────────────────── */}
				<section class="band" id="hackathons" aria-labelledby="hack-h">
					<div class="split">
						<div>
							<p class="lbl mono" style="margin-bottom: 1rem;">Start with a hackathon</p>
							<h2 id="hack-h" class="h2">A deadline, a theme and a prize. The best way to build your first app.</h2>
							<p class="lede" style="margin-top: 1.25rem;">
								Caddie finds open hackathons that fit you, reads the rules so you
								don't miss a requirement, and keeps your plan inside them.
							</p>
							<ul class="ticks">
								<li>Finds hackathons that are open right now</li>
								<li>Reads the fine print: who can enter, the deadline, what you must use, with the source quoted</li>
								<li>Plans your app to meet the rules</li>
								<li>Keeps the deadline in front of you</li>
							</ul>
						</div>
						<Shot name="hackathons" device="desktop" alt="Open hackathons, matched to you, with their rules read" />
					</div>
				</section>

				{showExample && (
					<section class="band" id="example" aria-labelledby="example-h">
						<div class="split">
							<div>
								<p class="lbl mono" style="margin-bottom: 1rem;">Built with Caddie</p>
								<h2 id="example-h" class="h2">A real app, built from a paragraph.</h2>
							</div>
							<Shot name="example" device="phone" alt="An app Caddie built, running on a phone" />
						</div>
					</section>
				)}

				{/* UNDER THE HOOD ─────────────────────────────────────── */}
				<section class="band" id="tech" aria-labelledby="tech-h">
					<div class="band-head">
						<div>
							<p class="lbl mono" style="margin-bottom: 1rem;">Under the hood</p>
							<h2 id="tech-h" class="h2">NVIDIA Nemotron on Nebius Token Factory, end to end.</h2>
						</div>
						<p class="lede">
							For the technically curious. None of this is something you have to
							set up.
						</p>
					</div>
					<ul class="tech">
						<li>
							<h3>Nemotron models, matched to the job</h3>
							<p>Nemotron 3.5 Super VL writes and tests the code and reads images. Nemotron 3 Ultra helps shape ideas. Nemotron 3 Nano reads contest rules. GLM-5.3-Flash drafts plans. All through Nebius Token Factory.</p>
						</li>
						<li>
							<h3>Built and tested in Token Factory Sandboxes</h3>
							<p>Generated code never runs on your computer. Each feature is built in an isolated sandbox and only counts as done when its tests pass there.</p>
						</li>
						<li>
							<h3>Checked by Caddie, not by the AI's word</h3>
							<p>"Done" is decided by real checks — tests, a working preview, a design comparison — never by the model saying it finished.</p>
						</li>
						<li>
							<h3>AI built into every app</h3>
							<p>The apps Caddie builds can call Nemotron (3.5 Lightning, or Super VL for heavier work) with no API key to set up.</p>
						</li>
						<li>
							<h3>Live hackathon search with Tavily</h3>
							<p>Tavily search and page extraction find open hackathons and read their rules pages.</p>
						</li>
					</ul>
				</section>

				{/* FOR JUDGES ─────────────────────────────────────────── */}
				<section class="band" id="judges" aria-labelledby="judges-h">
					<div class="split">
						<div>
							<p class="lbl mono" style="margin-bottom: 1rem;">For judges</p>
							<h2 id="judges-h" class="h2">Sign in with your access code.</h2>
							<p class="lede" style="margin-top: 1.25rem;">
								On the sign-in page choose “Judging the hackathon? Use your access
								code”, enter the code from the Devpost testing instructions, then
								pick a judge name and a password. Next time, sign in with that name
								and password.
							</p>
						</div>
						<div>
							<p class="lbl mono">Demo limits, so every judge gets a turn</p>
							<ul class="ticks">
								<li>3 projects per judge</li>
								<li>3 build starts and 300 messages per 24 hours</li>
								<li>20 live hackathon searches per 24 hours</li>
								<li>Judge accounts can't publish apps</li>
							</ul>
						</div>
					</div>
				</section>

				{/* CLOSING ────────────────────────────────────────────── */}
				<section class="close" id="pb-start" aria-labelledby="pb-close-h">
					<div class="close-l">
						<svg class="close-mascot" viewBox="0 0 64 64" width="72" height="72" aria-hidden="true" style="display:block">
							<defs><linearGradient id="pb-mascot-close" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4d9fff"/><stop offset="1" stop-color="#2f7ddd"/></linearGradient></defs>
							<g><path d="M43 18V4.5" stroke="#2f7ddd" stroke-width="2.6" stroke-linecap="round" fill="none"/><path d="M43.6 4.6 53 8.1l-9.4 3.5z" fill="#f0a83c" stroke="#f0a83c" stroke-width="1.4" stroke-linejoin="round"/></g>
							<rect x="9" y="16.5" width="46" height="41.5" rx="18" fill="url(#pb-mascot-close)"/>
							<g fill="#090b10"><rect x="21" y="30" width="6.5" height="11" rx="3.25"/><rect x="36.5" y="30" width="6.5" height="11" rx="3.25"/><circle cx="25.4" cy="32.7" r="1.3" fill="#fff"/><circle cx="40.9" cy="32.7" r="1.3" fill="#fff"/></g>
							<path d="M28.6 46.6q3.4 3 6.8 0" fill="none" stroke="#090b10" stroke-width="2.2" stroke-linecap="round"/>
						</svg>
						<h2 id="pb-close-h" class="h2" style="margin-top: 1.25rem; max-width: 18ch;">Your idea is enough.</h2>
						<p class="lede" style="margin-top: 1.25rem;">
							Start with a hackathon, or with the thing you have always wanted to
							make. Caddie carries the build.
						</p>
					</div>
					<div class="close-r">
						<a class="btn btn-key" href={appHref}>Start building</a>
						<p class="hero-note">
							Caddie is invite-only during the hackathon.
							<a class="link-quiet" href={inviteHref}>Request an invite</a>
						</p>
					</div>
				</section>
			</main>

			<footer class="foot">
				<p class="foot-mark" aria-hidden="true">Caddie</p>
				<div class="foot-grid">
					<p>Built for the Nebius × NVIDIA Global AI Hackathon. Open source under the MIT license.</p>
					<nav class="foot-links" aria-label="Footer">
						<a href={appHref}>Open the app</a>
						<a href={inviteHref}>Request an invite</a>
					</nav>
				</div>
			</footer>

			<div class="mbar">
				<span>Build an app without code</span>
				<a class="btn btn-line" href={appHref} style="padding: 0.4375rem 0.75rem; font-size: 0.75rem;">Sign in</a>
			</div>
		</div>
		<script is:inline>
			// Theme toggle: label names the theme it switches TO; saves only on an
			// explicit choice (§3.9).
			(function () {
				var btn = document.querySelector('[data-pb-theme]');
				var label = function () {
					var current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
					var target = current === 'light' ? 'dark' : 'light';
					btn.setAttribute('aria-label', 'Switch to ' + target + ' theme');
				};
				if (btn) {
					btn.hidden = false;
					label();
					btn.addEventListener('click', function () {
						var current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
						var next = current === 'light' ? 'dark' : 'light';
						document.documentElement.setAttribute('data-theme', next);
						try { localStorage.setItem('caddie-theme', next); } catch (e) {}
						label();
					});
				}
				// Mobile bar hides while the closing card is visible (v2 §4).
				var mbar = document.querySelector('.mbar');
				var closing = document.getElementById('pb-start');
				if (mbar && closing && 'IntersectionObserver' in window) {
					new IntersectionObserver(
						function (entries) {
							mbar.style.display = entries[0].isIntersecting ? 'none' : '';
						},
						{ threshold: 0.15 }
					).observe(closing);
				}
			})();
		</script>
	</body>
</html>
