---
// P16 landing. Static Astro output composed into the Worker assets tree at /
// by scripts/compose-assets.ts. No client JavaScript: every meaningful
// string is server-rendered markup. Copy must match docs/feature-ledger.md
// availability — no testimonials, no metrics, no build-success claims.
import '../styles/site.css';
import Hero from '../components/Hero.astro';
import ProductDemo from '../components/ProductDemo.astro';
import Stories from '../components/Stories.astro';
import Availability from '../components/Availability.astro';
import Contact from '../components/Contact.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Caddie — discover, build, deliver with evidence</title>
    <meta
      name="description"
      content="Caddie is a persistent, evidence-backed assistant that discovers opportunities, plans and builds applications through specialist agents, and prepares verifiable submissions. Under active development; access by invitation."
    />
    <meta property="og:title" content="Caddie — discover, build, deliver with evidence" />
    <meta
      property="og:description"
      content="Discover opportunities, build through specialists, prepare verifiable submissions. Under active development; access by invitation."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#071120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Hero />
    <main id="main">
      <ProductDemo />
      <Stories />
      <Availability />
      <Contact />
    </main>
    <footer class="site-foot">
      <div class="shell foot-row">
        <a class="wordmark" href="/">Caddie</a>
        <nav class="foot-links" aria-label="Footer">
          <a href="#demo">Demo</a>
          <a href="#stories">How it works</a>
          <a href="#availability">Availability</a>
          <a href="#access">Request access</a>
        </nav>
      </div>
      <div class="shell">
        <p class="foot-note">
          Under active development. Statements on this page mirror the
          availability recorded in the project feature ledger; nothing here is
          a verified build claim.
        </p>
      </div>
    </footer>
  </body>
</html>
