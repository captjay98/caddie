		<script is:inline>
			// Theme toggle: label names the theme it switches TO; saves only on an
			// explicit choice (§3.9).
			(function () {
				var btn = document.querySelector('[data-pb-theme]');
				var label = function () {
					var current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
					var target = current === 'light' ? 'dark' : 'light';
					btn.setAttribute('aria-label', 'Switch to ' + target + ' theme');
				};
				if (btn) {
					btn.hidden = false;
					label();
					btn.addEventListener('click', function () {
						var current = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
						var next = current === 'light' ? 'dark' : 'light';
						document.documentElement.setAttribute('data-theme', next);
						try { localStorage.setItem('caddie-theme', next); } catch (e) {}
						label();
					});
				}
				// Mobile bar hides while the closing card is visible (v2 §4).
				var mbar = document.querySelector('.mbar');
				var closing = document.getElementById('pb-start');
				if (mbar && closing && 'IntersectionObserver' in window) {
					new IntersectionObserver(
						function (entries) {
							mbar.style.display = entries[0].isIntersecting ? 'none' : '';
						},
						{ threshold: 0.15 }
					).observe(closing);
				}
			})();
		</script>
	</body>
