---
import Shot from './Shot.astro';
const appHref = import.meta.env.DEV ? 'http://localhost:5176/app/' : '/app/';
// First-timer hero (2026-10-25 redo): says what you get and that you don't
// need to code. The art is real app screenshots (Shot slots), not mockups.
---

<section class="hero" aria-labelledby="pb-hero-h">
	<div class="hero-l">
		<p class="eyebrow"><span class="live-dot" aria-hidden="true"></span><span class="lbl mono">Build apps by talking · no coding</span></p>
		<h1 id="pb-hero-h" class="h1">You have an idea.<br />Caddie builds the app.</h1>
		<p class="lede">
			Tell Caddie what you want to make, in your own words. It plans it with
			you, builds it, checks that it really works, and gives you a link to
			share. You don't need to know how to code.
		</p>
		<div class="hero-cta">
			<a class="btn btn-key" href={appHref}>Start building</a>
			<a class="btn btn-line" href={appHref}>Judging? Use your access code</a>
		</div>
		<p class="hero-note">
			Invite-only during the hackathon. Judges: the access code is in the
			Devpost testing instructions.
		</p>
	</div>
	<div class="hero-r">
		<div class="hero-shots">
			<Shot name="hero" device="desktop" alt="Caddie turning a plain-language idea into a plan" eager />
			<Shot name="hero" device="phone" alt="An app Caddie built, open on a phone" eager />
		</div>
	</div>
</section>
