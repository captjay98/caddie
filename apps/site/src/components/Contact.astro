// Request access. The mailto address below is a deliberate, clearly-marked
// placeholder: hello@example.com awaits the owner's real contact address.
// Replace it here AND in the HTML comment in the markup before any public
// deployment. Do not invent a real-looking address on a domain we don't own.
---

<section class="section contact" id="access" aria-labelledby="access-title">
  <div class="shell contact-grid">
    <div>
      <p class="kicker-inline">Request access</p>
      <h2 id="access-title">Build with Caddie first</h2>
      <p class="section-lede">
        Caddie launches by invitation. Tell us what you would build and which
        stack you care about, and we will reach out as capacity opens.
      </p>
    </div>

    <div class="contact-card">
      <!-- PLACEHOLDER CONTACT: hello@example.com awaits the owner's real address; replace before any public deployment. -->
      <a
        class="cta cta-primary"
        href="mailto:hello@example.com?subject=Caddie%20access%20request"
      >
        Request access by email
      </a>
      <p class="contact-note">A plain email link — no form, no tracking.</p>
    </div>
  </div>
</section>
