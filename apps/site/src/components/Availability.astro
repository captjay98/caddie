---
// Honest availability, mirroring docs/feature-ledger.md's supported-stack
// table: react-hono is "proving first" behind the P09 gate; every other
// stack is "planned" until its own gate passes. No verified labels.
const stacks = [
  {
    id: 'react-hono',
    name: 'React + Hono',
    desc: 'Vite/TanStack Router+Query client on a Bun/Hono worker — the first stack being proven end to end.',
    status: 'proving-first',
    label: 'proving first',
  },
  {
    id: 'tanstack-start',
    name: 'TanStack Start',
    desc: 'Full-stack React output with server behavior.',
    status: 'planned',
    label: 'planned',
  },
  {
    id: 'laravel-inertia',
    name: 'Laravel + React/Inertia',
    desc: 'PHP full-stack output with session-backed behavior.',
    status: 'planned',
    label: 'planned',
  },
  {
    id: 'fastapi-react',
    name: 'FastAPI + React',
    desc: 'Python API with a generated React client.',
    status: 'planned',
    label: 'planned',
  },
  {
    id: 'flutter',
    name: 'Flutter',
    desc: 'Mobile output paired with a supported backend, with real device evidence.',
    status: 'planned',
    label: 'planned',
  },
];
---

<section class="section availability" id="availability" aria-labelledby="avail-title">
  <div class="shell">
    <p class="kicker-inline">Honest status</p>
    <h2 id="avail-title">What exists today — stated plainly</h2>
    <p class="section-lede">
      Caddie is under active development. These are the supported output
      stacks; a stack earns a verified label only after its full acceptance
      gate passes, and none has yet.
    </p>

    <ul class="stack-list">
      {
        stacks.map((stack) => (
          <li data-status={stack.status}>
            <span class="stack-name">{stack.name}</span>
            <span class="stack-desc">{stack.desc}</span>
            <span class:list={['chip', stack.status === 'proving-first' && 'chip-blue']}>
              {stack.label}
            </span>
          </li>
        ))
      }
    </ul>

    <p class="avail-note">
      Shared contracts, routing composition and the verification harness exist
      today. The workspace, discovery, evidence and submission capabilities
      arrive with their own packets and gates — no capability on this page is
      claimed as verified before its evidence exists.
    </p>
  </div>
</section>
