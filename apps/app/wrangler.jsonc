{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "caddie-app",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// P12 schedule dispatch: fires the `scheduled` handler exported from
	// src/cloudflare.ts (default export), which runs dispatchDueSchedules.
	"triggers": { "crons": ["*/5 * * * *"] },
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "traces": { "enabled": true } },
	// Every agent generates a Durable Object class named after its identity
	// (Hello -> FlueHelloAgent), and Cloudflare requires a migration entry
	// for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueHelloAgent"] }, { "tag": "v2", "new_sqlite_classes": ["FlueCoordinatorAgent"] }, { "tag": "v3", "new_sqlite_classes": ["PreviewDatabase"] }],
	// Backend previews (docs/plans/2026-10-17-publish): an app's server bundle
	// runs in a Worker Loader isolate; its test data lives in a per-project
	// PreviewDatabase Durable Object (classes exported from src/cloudflare.ts).
	"worker_loaders": [{ "binding": "LOADER" }],
	"durable_objects": {
		"bindings": [{ "name": "PREVIEW_DB", "class_name": "PreviewDatabase" }]
	},
	// Product state (P02 owns migrations/0001_product.sql onward; migration
	// numbering is integration-lead-owned). database_id is a local-dev
	// placeholder — a real id is a setup input before any deployment (P17).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "caddie",
			"database_id": "local-dev-placeholder"
		}
	],
	// Composed static assets (Astro landing + React SPA) written by
	// scripts/compose-assets.ts. run_worker_first keeps /api, /agents and
	// /app in the Worker so API 404s stay JSON and /app deep links fall back
	// to the SPA shell; the landing tree at / is served directly.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": ["/api", "/api/*", "/agents", "/agents/*", "/app", "/app/*", "/report", "/operator", "/operator/*"]
	},
	// Production (S10, docs/runbooks/production-deploy.md). It is chosen at
	// BUILD time, never with `wrangler deploy --env`:
	//   CLOUDFLARE_ENV=production bun run build
	// The Vite plugin flattens this block into dist/caddie_app/wrangler.json,
	// which `wrangler deploy` (run from apps/app) uploads. An environment does
	// not inherit bindings, so each binding above is restated here. The two
	// <...> values are owner inputs; scripts/deploy-preflight.ts fails while
	// either is still a placeholder. No value lives in this file: secrets,
	// emails, client ids and the judge code go in the gitignored
	// apps/app/.prod.vars, uploaded with `wrangler deploy --secrets-file`.
	"env": {
		"production": {
			"name": "caddie-app",
			// One public address. preview_urls would add per-version
			// workers.dev addresses where sign-in cannot work.
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "<CADDIE_DOMAIN>", "custom_domain": true }],
			// Workers Logs on for judging, alongside the traces above.
			"observability": { "enabled": true, "traces": { "enabled": true } },
			"worker_loaders": [{ "binding": "LOADER" }],
			"durable_objects": {
				"bindings": [{ "name": "PREVIEW_DB", "class_name": "PreviewDatabase" }]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "caddie",
					"database_id": "<PRODUCTION_D1_DATABASE_ID>",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
