APP_NAME="Forge App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Disposable-by-default sqlite database. Generate it (and APP_KEY) with:
#   php artisan touch: database/database.sqlite && php artisan key:generate
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
