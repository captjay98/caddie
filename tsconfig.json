{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@caddie/contracts": [
				"./packages/contracts/src/index.ts"
			],
			"@tanstack/react-query": [
				"./apps/app/node_modules/@tanstack/react-query"
			],
			"@durable-streams/client": [
				"./node_modules/.bun/@durable-streams+client@0.2.7/node_modules/@durable-streams/client"
			]
		},
		"jsx": "react-jsx"
	},
	"include": [
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"packages/contracts/src/**/*.ts",
		"workers/**/*.ts",
		"apps/app/src/vite-env.d.ts",
		"apps/app/src/cloudflare-workers.d.ts"
	],
	"exclude": [
		"tests/fixtures/forge-task-tracker",
		"tests/fixtures/preview-app"
	]
}
