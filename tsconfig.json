{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ESNext",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@caddie/contracts": [
				"./packages/contracts/src/index.ts"
			]
		},
		"jsx": "react-jsx"
	},
	"include": [
		"scripts/**/*.ts",
		"tests/**/*.ts",
		"packages/contracts/src/**/*.ts",
		"apps/app/src/vite-env.d.ts",
		"apps/app/src/cloudflare-workers.d.ts"
	],
	"exclude": [
		"tests/fixtures/forge-task-tracker"
	]
}
